---
import Base from "./Base.astro";
import { CopyPage } from "../components/CopyPage";
import { DocsShell } from "../components/DocsShell";
import OnThisPage from "../components/OnThisPage.astro";
import { PageHeading } from "@handamade/psi-react";
import { docsNav } from "../content/docs-nav";
import "../styles/docs.css";

interface Props {
  title: string;
  description: string;
  headings: { depth: number; slug: string; text: string }[];
  /** URL of this page's markdown twin. */
  mdHref: string;
  /** The twin's text, embedded so Copy page needs no fetch. */
  mdSource: string;
}
const { title, description, headings, mdHref, mdSource } = Astro.props;
const currentPath = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
---

<Base title={`${title} — Psi`} description={description}>
  <link slot="head" rel="alternate" type="text/markdown" href={mdHref} />
  <DocsShell client:load nav={docsNav} currentPath={currentPath}>
    <div class="docs-page">
      <div class="docs-content" data-pagefind-body>
        <PageHeading>{title}</PageHeading>
        <div class="docs-actions" data-pagefind-ignore><CopyPage client:idle markdown={mdSource} /></div>
        <slot />
      </div>
      <OnThisPage headings={headings} />
    </div>
  </DocsShell>
</Base>
