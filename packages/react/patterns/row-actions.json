{
  "id": "row-actions",
  "intent": "List or table row with an icon-only actions menu, including a destructive item — hand the destructive item's confirmation off to the destructive-confirm pattern",
  "match": [
    "row actions",
    "per-row actions",
    "table row menu",
    "actions menu",
    "row action list"
  ],
  "compose": {
    "component": "Menu",
    "props": {
      "placement": "{param:placement}",
      "aria-label": "{content:trigger-label}",
      "open": "{state:open}",
      "onClose": "{set:open:false}"
    },
    "slots": {
      "trigger": [
        {
          "component": "IconButton",
          "props": {
            "variant": "ghost",
            "aria-label": "{content:trigger-label}",
            "onClick": "{toggle:open}",
            "aria-expanded": "{state:open}"
          },
          "content": "trigger-icon"
        }
      ],
      "body": [
        {
          "component": "MenuItem",
          "content": "edit-label",
          "props": {
            "onSelect": "{input:onEdit}"
          }
        },
        {
          "component": "MenuItem",
          "content": "duplicate-label",
          "props": {
            "onSelect": "{input:onDuplicate}"
          }
        },
        {
          "component": "MenuSeparator"
        },
        {
          "component": "MenuItem",
          "props": {
            "variant": "danger",
            "onSelect": "{input:onDelete}"
          },
          "content": "delete-label"
        }
      ]
    }
  },
  "parameters": [
    {
      "key": "placement",
      "ask": "Which side should the menu open on?",
      "options": [
        "bottom-start",
        "bottom-end"
      ],
      "default": "bottom-end"
    }
  ],
  "content": {
    "trigger-label": "Actions",
    "trigger-icon": "the ellipsis glyph",
    "edit-label": "Edit",
    "duplicate-label": "Duplicate",
    "delete-label": "Delete"
  },
  "state": [
    {
      "key": "open",
      "initial": false
    }
  ],
  "inputs": [
    {
      "key": "onEdit",
      "type": "() => void"
    },
    {
      "key": "onDuplicate",
      "type": "() => void"
    },
    {
      "key": "onDelete",
      "type": "() => void"
    }
  ],
  "gaps": [],
  "requires": [
    {
      "content": "trigger-icon",
      "kind": "icon",
      "name": "IconMoreHorizontal"
    }
  ]
}
