{
  "name": "@handamade/psi-tokens",
  "version": "0.21.0",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./*.css": "./dist/*.css",
    "./components/*": "./dist/components/*",
    "./resolved/*": "./dist/resolved/*",
    "./dtcg/*": "./dist/dtcg/*",
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./generate": {
      "types": "./dist/generate/index.d.ts",
      "import": "./dist/generate/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js"
    },
    "./guidance.json": "./dist/guidance.json"
  },
  "bin": {
    "psi-theme": "./dist/cli/psi-theme.js"
  },
  "files": [
    "dist",
    "README.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsx scripts/build.ts",
    "dev": "tsx --watch scripts/build.ts --watch",
    "new-theme": "tsx scripts/new-theme.ts"
  },
  "dependencies": {
    "culori": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "tsx": "^4.19.0"
  }
}
